{
    "name": "infocyph/epicrypt",
    "description": "A Collection of useful PHP security functions.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "infocyph/pathwise": "^2.5"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Epicrypt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Epicrypt\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
