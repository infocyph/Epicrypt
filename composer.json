{
    "name": "infocyph/epicrypt",
    "description": "Modern cryptography, token, password and data-protection toolkit for PHP.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "phpseclib/phpseclib": "^4.0.3",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "infocyph/pathwise": "^4.2.1",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "^3.0",
        "nyholm/psr7": "^1.8.2",
        "php-http/mock-client": "^1.6.1"
    },
    "suggest": {
        "infocyph/runwire": "^3.0: Optional borrowed runtime cancellation and coroutine checkpoints for stream and remote JOSE operations."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Epicrypt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Epicrypt\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "benchmark:auth": "@php benchmarks/authentication.php",
        "benchmark:ci": "@composer ic:bench:quick"
    }
}
